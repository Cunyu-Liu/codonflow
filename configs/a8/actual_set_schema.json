{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cunyu-Liu/codonflow/configs/a8/actual_set_schema.json",
  "title": "CodonFlow A8 actual-output-set record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "method", "input", "code", "objective_direction", "outputs", "cost", "trajectory", "comparability"],
  "properties": {
    "schema_version": {"const": "a8_actual_set_v1"},
    "run_id": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protein_id", "cds_sha256", "utr_sha256", "host"],
      "properties": {
        "protein_id": {"type": "string", "minLength": 1},
        "cds_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "utr_sha256": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
        "host": {"type": "string", "minLength": 1}
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "objective_direction": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"enum": ["maximize", "minimize"]}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_id", "cds", "cds_sha256", "objectives"],
        "properties": {
          "output_id": {"type": "string", "minLength": 1},
          "cds": {"type": "string", "pattern": "^[ACGTacgt]+$"},
          "cds_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "objectives": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "number"}
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cache_before_requests", "unique_scorer_calls", "model_forward_calls", "generation_seconds", "scoring_seconds", "wall_clock_seconds", "hardware", "parallelism", "unknown_reasons"],
      "properties": {
        "cache_before_requests": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "unique_scorer_calls": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "model_forward_calls": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "generation_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "scoring_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "wall_clock_seconds": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]},
        "hardware": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "parallelism": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "unknown_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dense_budget_step_auc_v2", "unavailable_reason"],
      "properties": {
        "dense_budget_step_auc_v2": {"type": "null"},
        "unavailable_reason": {"const": "no_real_dense_budget_trajectory"}
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_protein", "fixed_utr", "same_scorer", "same_cost_protocol", "notes"],
      "properties": {
        "fixed_protein": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
        "fixed_utr": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
        "same_scorer": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
        "same_cost_protocol": {"anyOf": [{"type": "boolean"}, {"type": "null"}]},
        "notes": {"type": "string"}
      }
    }
  }
}
