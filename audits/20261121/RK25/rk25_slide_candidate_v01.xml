    <shape width="136" height="12" topLeftX="776" topLeftY="520" type="text"><content fontSize="9" fontFamily="Inter" color="rgba(100, 116, 139, 1)" textAlign="right" wrap="false"><p>117 · RK25</p></content></shape>
